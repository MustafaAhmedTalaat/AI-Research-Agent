{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-engine": {
      "root": "ai-engine",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "ai-engine"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
